# Plantilla de variables de entorno de Odontobot (demo clínica dental).
# Copia este archivo a `.env` (local) o pégalo en Environment de EasyPanel.
# NUNCA commitees `.env`. Está en .gitignore.
# No dejes variables con `=` vacío salvo las marcadas como opcionales:
# un valor vacío pisa el default del código.

# === OpenAI (obligatorio) ===
OPENAI_API_KEY=
OPENAI_MODEL_BRAIN=gpt-5.4-nano
OPENAI_MODEL_CATALOG=gpt-5.4-nano
OPENAI_MODEL_VISION=gpt-5.4-nano
OPENAI_REASONING_EFFORT=low

# === Supabase (obligatorio) — proyecto `demos` ===
SUPABASE_URL=https://lvvfxqdwolirpxdkhlqb.supabase.co
SUPABASE_SERVICE_KEY=

# === Cal.com (para agendar citas) ===
# Usa un event type propio de la clínica, no el de otro cliente.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# === Webchat (landing page) ===
# Opcional: si lo defines, /api/webchat exige el header X-API-Key. Úsalo
# solo si la landing llama al bot desde su servidor (proxy), nunca desde
# JavaScript del navegador.
WEBCHAT_API_KEY=
WEBCHAT_RATE_LIMIT_PER_MIN=30
WEBCHAT_MAX_TEXT_LEN=2000

# CORS: dominios desde los que el navegador puede llamar al bot
# (landing y dashboard), separados por coma y sin "/" al final.
DASHBOARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Dashboard CRM (opcional) ===
DASHBOARD_API_KEY=

# === Panel /panel (encender/apagar canales) ===
# Genera con: openssl rand -hex 24
TEST_ARM_TOKEN=

# === Canales para después (déjalos fuera mientras no se usen) ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# MANYCHAT_API_TOKEN=
# MANYCHAT_WEBHOOK_SECRET=

# === Anti-abuso ===
CHAT_RATE_LIMIT_PER_MIN=20
CHAT_RATE_LIMIT_PER_DAY=500
CHAT_TOKEN_BUDGET_PER_DAY=80000
GLOBAL_TOKEN_BUDGET_PER_DAY=2000000

# === Logs ===
LOG_LEVEL=INFO
