# Plantilla de variables de entorno del chatbot.
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA commitees `.env`. Está en .gitignore.

# === OpenAI ===
OPENAI_API_KEY=
OPENAI_MODEL_BRAIN=gpt-4.1-mini
OPENAI_MODEL_CATALOG=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o-mini

# === Supabase ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# === Cal.com ===
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# === Canales ===
TELEGRAM_BOT_TOKEN=
# Genera con: openssl rand -hex 32 — y configúralo igual en BotFather.
TELEGRAM_WEBHOOK_SECRET=
MANYCHAT_API_TOKEN=
# Opcional pero RECOMENDADO: configura el mismo valor como header
# X-ManyChat-Secret en el External Request de ManyChat.
MANYCHAT_WEBHOOK_SECRET=

# === Dashboard CRM ===
DASHBOARD_API_KEY=
DASHBOARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Regex opcional para varios subdominios tuyos. EVITA `.*\.vercel\.app`.
DASHBOARD_CORS_ORIGIN_REGEX=

# === Webchat (widget en alekagency.com) ===
WEBCHAT_API_KEY=
WEBCHAT_RATE_LIMIT_PER_MIN=30
WEBCHAT_MAX_TEXT_LEN=2000

# === Anti-abuso ===
CHAT_RATE_LIMIT_PER_MIN=20
CHAT_RATE_LIMIT_PER_DAY=500
CHAT_TOKEN_BUDGET_PER_DAY=80000
GLOBAL_TOKEN_BUDGET_PER_DAY=2000000
SUSPICIOUS_BLOCK_THRESHOLD=5
MAX_REQUEST_BODY_BYTES=1048576

# === Panel /panel ===
TEST_ARM_TOKEN=

# === Logs ===
LOG_LEVEL=INFO
SECURITY_LOG_DIR=logs
